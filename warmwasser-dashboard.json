      "title": "Maximum",
      "type": "stat"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "description": "Durchschnitt im gewählten Zeitraum.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "mappings": [], "unit": "celsius" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${datasource}" },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"environment\" and r[\"_field\"] == \"watertemperature\")\n  |> mean()\n  |> keep(columns: [\"_value\"])",
          "refId": "A"
