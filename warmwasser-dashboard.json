  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["warmwasser", "temperatur", "influxdb"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "influxdb",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": { "text": "telemetry", "value": "telemetry" },
        "hide": 0,
        "label": "Bucket",
        "name": "bucket",
        "options": [ { "selected": true, "text": "telemetry", "value": "telemetry" } ],
        "query": "telemetry",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["1h", "6h", "12h", "24h", "2d", "7d", "30d", "90d"]
  },
  "timezone": "",
  "title": "Warmwassertemperatur",
  "uid": "warmwasser",
  "version": 1,
  "weekStart": "",
