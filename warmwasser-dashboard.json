    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "description": "Aktuelle Warmwassertemperatur.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "mappings": [], "max": 70, "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null }, { "color": "green", "value": 40 }, { "color": "orange", "value": 55 }, { "color": "red", "value": 65 } ] },
          "unit": "celsius"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${datasource}" },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"environment\" and r[\"_field\"] == \"watertemperature\")\n  |> last()\n  |> keep(columns: [\"_value\"])",
          "refId": "A"
        }
      ],
      "title": "Warmwasser aktuell",
      "type": "gauge"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "description": "Warmwassertemperatur über den gewählten Zeitraum.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": {
            "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "°C", "axisPlacement": "auto",
            "drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity", "lineInterpolation": "smooth",
            "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never",
            "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [], "unit": "celsius"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["min", "max", "mean", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${datasource}" },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"environment\" and r[\"_field\"] == \"watertemperature\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"room\"])\n  |> group(columns: [\"room\"])",
          "refId": "A"
        }
      ],
      "title": "Warmwassertemperatur",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
